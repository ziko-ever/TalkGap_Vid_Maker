<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">


    <TextureView
        android:id="@+id/texture_view_selfie"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ImageButton
        android:visibility="gone"
        android:layout_margin="5dp"
        android:id="@+id/back_btn"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/dp5"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_back"/>

    <ImageButton
        android:layout_margin="5dp"
        android:id="@+id/close_btn"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/dp5"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_clear"/>


    <LinearLayout
        android:id="@+id/cam_actions_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:orientation="vertical">
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/switch_cam_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_autorenew"/>
        <ImageButton
            android:layout_margin="5dp"
            style="@style/clickableImageButton"
            android:id="@+id/flash_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_flash_on"/>
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/timer_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_timer"/>
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/speed_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_speed"/>
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/filter_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_filter"/>
    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#90000000"
        android:id="@+id/filter_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">
            <com.google.android.material.tabs.TabLayout
                android:background="#90000000"
                app:tabTextColor="@android:color/white"
                app:tabIndicatorColor="@android:color/white"
                android:id="@+id/filter_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        <com.xheghun.vidit.XheghunViewPager
            android:id="@+id/filter_viewpager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/snap_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp5"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center">


        <LinearLayout
            android:id="@+id/add_music_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                style="@style/clickableImageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_music_note" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/open_sans_bold"
                android:text="@string/add_music"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <ImageButton
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:id="@+id/snap_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/circle_outline"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/effects_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                style="@style/clickableImageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_color_lens" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/open_sans_bold"
                android:text="@string/effects"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>