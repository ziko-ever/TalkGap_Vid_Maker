<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wrap_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.LiveVideoEditor2Fragment">

    <com.talkgap.ui.surfaceview.SampleCameraGLView
        android:id="@+id/texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp"
        android:layout_gravity="left">

        <ImageButton
            android:id="@+id/close_fragment"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_close"
            android:padding="5dp"
            android:background="@drawable/circle"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>



    <LinearLayout
        android:id="@+id/lyt_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/circle_red" />

        <TextView
            android:id="@+id/txt_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="Ilove u"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/timing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:background="@color/colorAccent">

        <ImageButton
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_timer"
            android:padding="5dp"
            android:background="@drawable/circle"
            />

        <ImageButton
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_timer"
            android:padding="5dp"
            android:background="@drawable/circle"
            />


        <ImageButton
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_timer"
            android:padding="5dp"
            android:background="@drawable/circle"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp"
        android:layout_gravity="right">

        <ImageButton
            android:id="@+id/btn_flash"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_flash_off"
            android:padding="5dp"
            android:background="@drawable/circle"
            android:layout_marginBottom="10dp"
            />

        <ImageButton
            android:id="@+id/timer"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_timer"
            android:padding="5dp"
            android:background="@drawable/circle"
            android:layout_marginBottom="10dp"
            />

        <ImageButton
            android:id="@+id/add_filter"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:padding="5dp"
            android:background="@drawable/circle"
            android:src="@drawable/ic_filter"
            android:layout_marginBottom="10dp"
            />

        <ImageButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_autorenew"
            android:padding="5dp"
            android:background="@drawable/circle"
            android:layout_marginBottom="10dp"
            />

    </LinearLayout>



    <LinearLayout
        android:id="@+id/central_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:orientation="horizontal"
        android:layout_marginBottom="100dp">

        <ImageButton
            android:layout_marginTop="20dp"
            android:id="@+id/add_music"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_music_note"
            android:padding="5dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/circle"
            android:layout_gravity="center_vertical"
            />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">

            <com.vaibhavlakhera.circularprogressview.CircularProgressView
                android:id="@+id/btn_record"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:clickable="true"
                app:fillColor="@color/colorRed"
                app:progressColor="#FFF"
                app:progressInterpolator="@android:anim/accelerate_decelerate_interpolator"
                app:progressRoundCap="true"
                app:progressTextColor="#FFF"
                app:progressTextEnabled="true"
                app:progressTextSize="32sp"
                app:progressTextType="progress"
                app:progressValue="0"
                app:progressWidth="8dp"
                app:startAngle="270"
                app:totalColor="#901976D2"
                app:totalValue="15"
                app:totalWidth="10dp" />

        </RelativeLayout>

        <!--        <ImageButton-->
        <!--            android:id="@+id/start_preview"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_alignParentRight="true"-->
        <!--            android:background="@color/transparentbg"-->
        <!--            android:src="@drawable/ic_record_transparent_outer" />-->

        <ImageButton
            android:layout_marginTop="20dp"
            android:id="@+id/add_effect"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_effect"
            android:padding="5dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/circle"
            android:layout_gravity="center_vertical"
            />



    </LinearLayout>

    <include layout="@layout/filter_view"
        android:id="@+id/lyt_filter"
        android:layout_gravity="bottom|center"
        android:layout_height="wrap_content"
        android:layout_width="match_parent" />

    <include layout="@layout/effect_view"
        android:id="@+id/lyt_effect"
        android:layout_gravity="bottom|center"
        android:layout_height="wrap_content"
        android:layout_width="match_parent" />

    <include
        android:id="@+id/lyt_preview"
        layout="@layout/preview_view"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom|center" />

