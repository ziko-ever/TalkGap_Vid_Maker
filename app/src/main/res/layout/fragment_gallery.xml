<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    tools:context="com.xheghun.vidit.fragments.GalleryFragment">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/status_margin"
        android:layout_width="match_parent"
        android:layout_marginBottom="10dp"
        android:layout_height="28dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageButton
            android:padding="@dimen/dp5"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_close"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/gallery_tab_layout"
            android:layout_gravity="center_horizontal"
            app:tabBackground="@color/gray"
            app:tabPaddingStart="25dp"
            app:tabPaddingEnd="25dp"
            app:tabPaddingTop="0dp"
            app:tabPaddingBottom="0dp"
            android:layout_width="wrap_content"
            app:tabSelectedTextColor="@android:color/white"
            app:tabTextAppearance="@style/tabTextAppearance2"
            app:tabTextColor="@color/white"
            app:tabIndicatorColor="@color/colorPrimary"
            android:layout_height="wrap_content"
            app:tabIndicatorGravity="stretch"
            app:tabMode="fixed"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/gallery_viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>