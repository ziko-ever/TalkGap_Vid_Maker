<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context="com.xheghun.vidit.fragments.FourSnapFragment">

    <TextureView
        android:id="@+id/texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageButton
        android:layout_margin="5dp"
        android:id="@+id/back_btn"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/dp5"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_clear"/>
    <LinearLayout
        android:id="@+id/cam_actions_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:orientation="vertical">
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/switch_cam_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_autorenew"/>
        <ImageButton
            android:layout_margin="5dp"
            style="@style/clickableImageButton"
            android:id="@+id/flash_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_flash_on"/>
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/timer_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_timer"/>
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/speed_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_speed"/>
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/filter_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_filter"/>
    </LinearLayout>
    <ImageButton
        android:layout_marginBottom="30dp"
        android:id="@+id/snap_btn"
        android:background="@drawable/circle_outline"
        android:layout_alignParentBottom="true"
        android:clickable="true"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:id="@+id/effects_btn"
        android:clickable="true"
        android:focusable="true"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/snap_btn"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_color_lens"/>
        <TextView
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/effects"
            android:textColor="@android:color/white"
            android:fontFamily="@font/open_sans_bold"/>

    </LinearLayout>


    <LinearLayout
        android:visibility="gone"
        android:id="@+id/filter_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">
        <LinearLayout
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/close_filter_btn"
                android:padding="@dimen/dp5"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_block"/>
            <LinearLayout
                android:layout_margin="6dp"
                android:layout_gravity="center_vertical"
                android:layout_width="2dp"
                android:background="@android:color/darker_gray"
                android:layout_height="match_parent"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/filter_tab"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <com.xheghun.vidit.XheghunViewPager
            android:id="@+id/filter_viewpager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

</RelativeLayout>