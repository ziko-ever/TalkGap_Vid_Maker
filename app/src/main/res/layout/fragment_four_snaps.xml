<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context="com.xheghun.vidit.fragments.FourSnapFragment">

    <TextureView
        android:id="@+id/texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageButton
        android:layout_margin="5dp"
        android:id="@+id/close_btn"
        android:padding="@dimen/dp5"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_clear"/>
    <ImageButton
        android:layout_margin="5dp"
        android:id="@+id/back_btn"
        android:padding="@dimen/dp5"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:src="@drawable/ic_arrow_back"/>
    <LinearLayout

        android:id="@+id/cam_actions_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:orientation="vertical">
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/switch_cam_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_autorenew"/>
        <ImageButton
            android:layout_margin="5dp"
            style="@style/clickableImageButton"
            android:id="@+id/flash_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_flash_on"/>
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/timer_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_timer"/>
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/speed_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_speed"/>
        <ImageButton
            style="@style/clickableImageButton"
            android:layout_margin="5dp"
            android:id="@+id/filter_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_filter"/>

            <ImageButton
                style="@style/clickableImageButton"
                android:layout_margin="5dp"
                android:id="@+id/effects_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_color_lens"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/dp5"
        android:orientation="horizontal"
        android:layout_above="@id/cancel_snap_btn">
        <ImageButton
            android:id="@+id/snap_btn"
            android:background="@drawable/circle_outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:visibility="gone"
            android:id="@+id/next_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabSize="mini"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_arrow_forward" />
    </LinearLayout>



    <com.google.android.material.button.MaterialButton
        android:visibility="invisible"
        android:layout_marginBottom="10dp"
        android:id="@+id/cancel_snap_btn"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_width="wrap_content"
        app:icon="@drawable/ic_close"
        app:iconTint="@color/white"
        app:iconGravity="textStart"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_height="wrap_content"/>

    <include layout="@layout/filter_layout" />

    <include layout="@layout/effects_layout"/>

</RelativeLayout>