<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context="com.xheghun.vidit.fragments.FourSnapFragment">

    <TextureView
        android:id="@+id/texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

   <!-- <LinearLayout
        android:orientation="vertical"
        android:id="@+id/status_margin"
        android:layout_width="match_parent"
        android:layout_height="28dp"/>-->

    <ImageButton
        android:layout_margin="5dp"
        android:id="@+id/close_btn"
        android:padding="@dimen/dp5"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_clear"/>
    <ImageButton
        android:layout_margin="5dp"
        android:id="@+id/back_btn"
        android:padding="@dimen/dp5"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:src="@drawable/ic_arrow_back"/>

    <include layout="@layout/four_snap_cam_actions" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/dp5"
        android:orientation="horizontal"
        android:layout_above="@id/cancel_snap_btn">
        <LinearLayout
            android:id="@+id/snap_btn_lyt"
            android:background="@drawable/circle_outline"
            android:layout_width="wrap_content"
            android:gravity="center"
            android:layout_height="wrap_content">
            <TextView
                android:background="@drawable/solid_circle"
                android:id="@+id/snap_btn"
                android:gravity="center"
                android:textAllCaps="true"
                android:fontFamily="@font/open_sans_semi_bold"
                android:text="@string/snap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>


        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:visibility="gone"
            android:id="@+id/next_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabSize="mini"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_arrow_forward" />
    </LinearLayout>



    <com.google.android.material.button.MaterialButton
        android:visibility="invisible"
        android:layout_marginBottom="10dp"
        android:id="@+id/cancel_snap_btn"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_width="wrap_content"
        app:icon="@drawable/ic_close"
        app:iconTint="@color/white"
        app:iconGravity="textStart"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:visibility="gone"
        android:background="#90000000"
        android:id="@+id/effects_layout_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            app:tabTextAppearance="@style/tabTextAppearance"
            android:background="#90000000"
            app:tabTextColor="@android:color/white"
            app:tabIndicatorColor="@android:color/white"
            android:id="@+id/effects_tab_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.xheghun.vidit.XheghunViewPager
            android:id="@+id/effects_viewpager_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:background="#90000000"
        android:id="@+id/filter_layout_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            app:tabTextAppearance="@style/tabTextAppearance"
            android:background="#90000000"
            app:tabTextColor="@android:color/white"
            app:tabIndicatorColor="@android:color/white"
            android:id="@+id/filter_tab_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.xheghun.vidit.XheghunViewPager
            android:id="@+id/filter_viewpager_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</RelativeLayout>