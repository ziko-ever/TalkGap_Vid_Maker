<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sound_layout"
    android:paddingStart="@dimen/dp5"
    android:paddingEnd="@dimen/dp5"
    android:paddingBottom="10dp"
    android:visibility="gone"
    android:layout_above="@+id/cut_tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#90000000"
    android:orientation="vertical"
    tools:showIn="@layout/activity_video_edit">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:fontFamily="@font/open_sans_semi_bold"
        android:text="@string/background_sound"
        android:gravity="center" />

    <LinearLayout
        android:layout_marginTop="@dimen/dp5"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:padding="@dimen/dp5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/recorded_sound"
            android:textSize="15sp"
            android:fontFamily="@font/open_sans_semi_bold"
            android:textColor="@color/white" />

        <TextView
            android:gravity="end"
            android:padding="@dimen/dp5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/music"
            android:textSize="15sp"
            android:fontFamily="@font/open_sans_semi_bold"
            android:textColor="@color/white" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatSeekBar
        android:progress="50"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:progressDrawable="@drawable/progress_bar_style"
        android:thumb="@drawable/custom_thumb"
        android:layout_width="match_parent"
        android:layout_height="4dp" />

    <LinearLayout
        android:layout_margin="@dimen/dp5"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/change_music_btn"
            android:background="#757575"
            android:onClick="gotoMusicSelect"
            android:padding="4dp"
            android:layout_marginEnd="@dimen/dp5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:drawablePadding="@dimen/dp5"
            android:gravity="center"
            android:layout_gravity="center"
            android:drawableStart="@drawable/ic_music"
            android:drawableEnd="@drawable/ic_keyboard_arrow_right"
            android:text="Change Music" />

        <TextView
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:drawablePadding="@dimen/dp5"
            android:gravity="center"
            android:drawableTop="@drawable/ic_delete"
            android:text="Delete Sound" />
    </LinearLayout>
</LinearLayout>