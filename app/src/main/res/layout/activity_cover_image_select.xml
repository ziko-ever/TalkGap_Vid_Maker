<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#757575"
    tools:context="com.xheghun.vidit.CoverImageSelectActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        app:title="Select Your Video Cover"
        app:titleTextColor="@color/white"
        app:menu="@menu/cover_toolbar_action"
        app:navigationIcon="@drawable/ic_keyboard_arrow_left"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_below="@id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/image_frame"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_width="0dp"
                android:layout_weight="6"
                android:scaleType="centerCrop"
                android:layout_height="match_parent"
                android:src="@drawable/afro_woman"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"/>
        </LinearLayout>


        <TextView
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:fontFamily="@font/open_sans_bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:text="Drag to Select Cover"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/afro_woman"
                android:layout_width="60dp"
                android:scaleType="centerCrop"
                android:layout_height="60dp"/>
            <ImageView
                android:src="@drawable/afro_woman"
                android:layout_width="60dp"
                android:scaleType="centerCrop"
                android:layout_height="60dp"/>
            <ImageView
                android:src="@drawable/afro_woman"
                android:layout_width="60dp"
                android:scaleType="centerCrop"
                android:layout_height="60dp"/>
            <ImageView
                android:src="@drawable/afro_woman"
                android:layout_width="60dp"
                android:scaleType="centerCrop"
                android:layout_height="60dp"/>
            <ImageView
                android:src="@drawable/afro_woman"
                android:layout_width="60dp"
                android:scaleType="centerCrop"
                android:layout_height="60dp"/>
            <ImageView
                android:src="@drawable/afro_woman"
                android:layout_width="60dp"
                android:scaleType="centerCrop"
                android:layout_height="60dp"/>
            <ImageView
                android:src="@drawable/afro_woman"
                android:layout_width="60dp"
                android:scaleType="centerCrop"
                android:layout_height="60dp"/>
            <ImageView
                android:src="@drawable/afro_woman"
                android:layout_width="60dp"
                android:scaleType="centerCrop"
                android:layout_height="60dp"/>

        </LinearLayout>
    </LinearLayout>


</RelativeLayout>