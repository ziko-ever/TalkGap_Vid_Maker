<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_below="@id/video_progress_bar"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cam_actions_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentEnd="true"
    android:orientation="vertical"
    tools:showIn="@layout/fragment_selfie">

    <ImageButton
        style="@style/clickableImageButton"
        android:layout_margin="5dp"
        android:id="@+id/switch_cam_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_autorenew" />

    <TextView
        style="@style/camActionsTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Camera"
        android:layout_gravity="center"/>


    <ImageButton
        android:layout_margin="5dp"
        style="@style/clickableImageButton"
           android:id="@+id/flash_toggle_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_flash_on" />

    <TextView
        style="@style/camActionsTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flash"
        android:layout_gravity="center"/>

    <ImageButton
        style="@style/clickableImageButton"
        android:layout_margin="5dp"
        android:id="@+id/timer_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_timer" />

    <TextView
        style="@style/camActionsTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Timer"
        android:layout_gravity="center"/>

    <ImageButton
        style="@style/clickableImageButton"
        android:layout_margin="5dp"
        android:id="@+id/speed_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_speed" />

    <TextView
        style="@style/camActionsTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Speed"
        android:layout_gravity="center"/>

    <ImageButton
        style="@style/clickableImageButton"
        android:layout_margin="5dp"
        android:id="@+id/filter_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_filter" />

    <TextView
        style="@style/camActionsTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter"
        android:layout_gravity="center"/>
</LinearLayout>