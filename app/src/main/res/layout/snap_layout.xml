<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/snap_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dp5"
    android:layout_alignParentBottom="true"
    android:orientation="horizontal"
    android:gravity="center"
    tools:showIn="@layout/fragment_selfie">


    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp">
        <ImageButton
            android:layout_centerHorizontal="true"
            android:id="@+id/lt2"
            style="@style/clickableImageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_music_note" />

        <TextView
            android:layout_centerHorizontal="true"
            android:layout_below="@id/lt2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/open_sans_bold"
            android:text="@string/add_music"
            android:textColor="@android:color/white" />

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:id="@+id/add_music_btn"/>

    </RelativeLayout>

    <ImageButton
        android:layout_marginTop="10dp"
        android:layout_marginBottom="30dp"
        android:id="@+id/snap_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/circle_outline"
        android:clickable="true"
        android:focusable="true" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp">
        <ImageButton
            android:id="@+id/lt1"
            android:layout_centerHorizontal="true"
            style="@style/clickableImageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_color_lens" />

        <TextView
            android:layout_centerHorizontal="true"
            android:layout_below="@id/lt1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/open_sans_bold"
            android:text="@string/effects"
            android:textColor="@android:color/white" />

        <LinearLayout
            android:id="@+id/effects_btn"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_centerInParent="true"
            android:layout_width="60dp"
            android:layout_height="60dp"/>
    </RelativeLayout>
</LinearLayout>